{
  "extends": "@gmail/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": true,
    "composite": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@gmail/core": ["../../packages/core/src/index.ts"],
      "@gmail/gmail": ["../../packages/gmail/src/index.ts"],
      "@gmail/sync": ["../../packages/sync/src/index.ts"],
      "@gmail/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/**/*", "electron.vite.config.ts"]
}
